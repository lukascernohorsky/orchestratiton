[
 {saai, [
     {db, [
         {host, os:getenv("SAAI_DB_HOST", "localhost")},
         {port, list_to_integer(os:getenv("SAAI_DB_PORT", "5432"))},
         {user, os:getenv("SAAI_DB_USER", "saai")},
         {password, os:getenv("SAAI_DB_PASSWORD", "saai")},
         {database, os:getenv("SAAI_DB_NAME", "saai")}
     ]},
     {amqp, [
         {uri, os:getenv("SAAI_AMQP_URI", "amqp://guest:guest@localhost:5672")},
         {dispatch_exchange, "sys.core"},
         {dispatch_routing_key, "sys.core.task.dispatch"},
         {result_queue, "task_result_q"},
         {result_routing_key, "sys.core.task.result"}
     ]},
     {mqtt, [
         {host, os:getenv("SAAI_MQTT_HOST", "localhost")},
         {port, list_to_integer(os:getenv("SAAI_MQTT_PORT", "1883"))},
         {clientid, "saai-core"},
         {topic, "sys.ui.updates"}
     ]},
     {http, [
         {port, list_to_integer(os:getenv("SAAI_HTTP_PORT", "8080"))}
     ]},
     {scheduler, [
         {poll_interval_ms, 2000}
     ]}
 ]}
].
