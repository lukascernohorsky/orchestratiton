%% Rebar configuration for S.A.A.I. orchestrator
{erl_opts, [debug_info, warn_export_all, warn_unused_import, warn_missing_spec]}.

{deps, [
    %% Database and pooling
    {epgsql, "~> 4.7"},
    {poolboy, "~> 1.5"},
    %% Messaging
    {amqp_client, "~> 3.12"},
    {rabbit_common, "~> 3.12"},
    {emqtt, "~> 1.4"},
    %% HTTP and JSON
    {cowboy, "~> 2.10"},
    {jsx, "~> 3.1"}
]}.

{shell, [
    {config, "config/sys.config"},
    {apps, [saai]}
]}.

{profiles, [
    {test, [{deps, []}]}
]}.
